# SMTP credentials for the weekly brief. PLACEHOLDERS ONLY -- never a real key here.
#   cp .env.example .env  &&  chmod 600 .env  &&  fill in the real values in .env
# scripts/send_report.py reads .env (never this file).
#
# Mandrill: USER is the Mandrill account username, PASS is an API key (md-...),
# and FROM is the envelope/header sender -- its domain must be verified in Mandrill
# and carry Mandrill's SPF include + DKIM record, or the mail will fail SPF.
# Office 365: USER is the mailbox address and PASS its password; leave FROM unset.
WEEKLY_AI_SMTP_USER=account-username-or-mailbox@example.com
WEEKLY_AI_SMTP_PASS=put-the-api-key-or-password-here
WEEKLY_AI_SMTP_FROM=
WEEKLY_AI_SMTP_SERVER=smtp.mandrillapp.com
WEEKLY_AI_SMTP_PORT=587
